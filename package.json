{
  "name": "vite-plugin-rescript",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fmt": "rescript format --all && prettier -l --write *.js *.json",
    "prebundle": "rescript build",
    "bundle": "bun build --target=node packages/vite-plugin-rescript/src/Plugin.res.mjs --minify --outdir ./packages/vite-plugin-rescript --entry-naming \"index.[ext]\"",
    "analyze": "rescript-tools reanalyze -json"
  },
  "dependencies": {
    "rescript": "12.0.0-beta.4"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
