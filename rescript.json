{
  "name": "vite-plugin-rescript",
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "bs-dependencies": ["@nojaf/vite-plugin-rescript"],
  "js-post-build": {
    "command": "bun build --target=node src/Plugin.res.mjs --outdir . --entry-naming \"index.[ext]\""
  }
}
