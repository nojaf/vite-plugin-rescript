{
  "name": "vite-plugin-rescript",
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "dependencies": ["@nojaf/vite-plugin-rescript"],
  "reanalyze": {
    "analysis": ["dce"],
    "suppress": []
  },
  "js-post-build": {
    "command": "bun build --target=node src/Plugin.res.mjs --outdir . --entry-naming \"index.[ext]\""
  }
}
